{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/gate-destructive-git.js",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/scan-secrets.js",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/scan-secrets.js",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/format-sdlc-docs.js",
        "failClosed": false
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/sdlc-stage-gate.js",
        "failClosed": false,
        "loop_limit": 3
      }
    ]
  }
}
